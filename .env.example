# Copie este archivo a .env (está excluido de Git) y complete los valores.
# NUNCA suba el .env ni el .p12 al repositorio.

# --- Certificado de firma electrónica ---------------------------------------
# Ruta del archivo PKCS#12. Se recomienda guardarlo en ./secrets/ (excluido
# de Git) con permisos 600.
SRI_P12_PATH=secrets/firma.p12
# Contraseña del .p12: indíquela aquí O, mejor, en un archivo aparte.
SRI_P12_PASSWORD=
# SRI_P12_PASSWORD_FILE=secrets/p12.password

# --- Datos del emisor (deben coincidir con su RUC en el SRI) -----------------
SRI_EMISOR_RUC=
SRI_EMISOR_RAZON_SOCIAL=
SRI_EMISOR_NOMBRE_COMERCIAL=
SRI_EMISOR_DIR_MATRIZ=
SRI_EMISOR_DIR_ESTABLECIMIENTO=
SRI_EMISOR_ESTAB=001
SRI_EMISOR_PTO_EMI=001
# SI o NO
SRI_EMISOR_OBLIGADO_CONTABILIDAD=NO
# Opcionales, solo si aplican a su RUC:
# SRI_EMISOR_CONTRIBUYENTE_ESPECIAL=
# SRI_EMISOR_AGENTE_RETENCION=
# "CONTRIBUYENTE RÉGIMEN RIMPE" o "CONTRIBUYENTE NEGOCIO POPULAR - RÉGIMEN RIMPE"
# SRI_EMISOR_CONTRIBUYENTE_RIMPE=

# --- SMTP (solo para ejemplos de envío de correo; aún no se usa) -------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TEST_TO=
